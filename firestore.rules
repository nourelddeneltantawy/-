rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (request.auth.token.email.lower() == 'nwnwraldynaltantawy@gmail.com' ||
         request.auth.token.email.lower() == 'nwraldynmstfymhmd@gmail.com');
    }

    function isDynamicAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isAdmin() {
      return isSuperAdmin() || isDynamicAdmin();
    }

    function isProtectedSuperAdmin(email) {
      return email.lower() == 'nwnwraldynaltantawy@gmail.com' || email.lower() == 'nwraldynmstfymhmd@gmail.com';
    }

    // Motors collection: Public read, Write/Delete for signed-in users
    match /motors/{motorId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Categories collection: Public read, Write/Delete for signed-in users
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Harnesses collection (ضفائر وتوصيلات الغسالة): Public read, Write/Delete for signed-in users
    match /harnesses/{harnessId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Appliance Parts collection (لوكات الباب، ليفلات، طلمبات): Public read, Write/Delete for signed-in users
    match /appliance_parts/{partId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // App Settings (بيانات التواصل والعنوان والمركز وتحديثات التطبيق): Public read and write
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // Admins management: Signed in users can check/list, Super Admins & Admins manage
    match /admins/{email} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // License Keys for Client Activation
    match /license_keys/{keyId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, delete: if isSignedIn();
      allow update: if true;
    }

    // Programming Softwares
    match /programming_software/{softwareId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Programming Folders (Hierarchy)
    match /programming_folders/{folderId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Firmware Dumps
    match /programming_dumps/{dumpId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Programmer Wiring Connections
    match /programming_connections/{connId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Real App Ratings submitted by authenticated users
    match /app_ratings/{ratingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // App Stats (Real user counter)
    match /app_stats/{statId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // App Visitors (Unique device tracking)
    match /app_visitors/{visitorId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // User Profiles (بيانات الفني والمهندس للبوستات)
    match /user_profiles/{profileId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Marketplace Posts (سوق كروت الغسالات: بيع وشراء)
    match /marketplace_posts/{postId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Technician Work Logs (سجل صيانة وكروت الفني المنفصل لكل مستخدم)
    match /technician_work_logs/{logId} {
      allow get, list, create, update, delete: if true;
    }

    // User Private Tools Settings (قوائم الأدوات الخاصة بكل مستخدم بالبريد الإلكتروني)
    match /user_tools_settings/{userEmail} {
      allow get, list, create, update, delete: if true;
    }
  }
}
