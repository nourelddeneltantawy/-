rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'nwnwraldynaltantawy@gmail.com' ||
         request.auth.token.email == 'nwraldynmstfymhmd@gmail.com');
    }

    function isDynamicAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSuperAdmin() || isDynamicAdmin();
    }

    function isProtectedSuperAdmin(email) {
      return email == 'nwnwraldynaltantawy@gmail.com' || email == 'nwraldynmstfymhmd@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(id) {
      return id is string && id.size() > 0 && id.size() <= 200 && id.matches('^[a-zA-Z0-9_.+@\\-]+$');
    }

    function isValidMotor(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        (!('brand' in data) || (data.brand is string && data.brand.size() <= 100)) &&
        (!('model' in data) || (data.model is string && data.model.size() <= 100)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('orderIndex' in data) || (data.orderIndex is int || data.orderIndex is number)) &&
        (!('motorType' in data) || (data.motorType is string && data.motorType.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
        data.pinouts is list && data.pinouts.size() <= 50 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminUser(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.addedBy is string && data.addedBy.size() > 0 && data.addedBy.size() <= 200 &&
        data.role is string && (data.role == 'admin' || data.role == 'super_admin') &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Motors collection: Public read, Write/Delete for signed-in users
    match /motors/{motorId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
        isValidId(motorId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == motorId &&
        isValidMotor(incoming());
      allow update: if isSignedIn() &&
        incoming().id == existing().id &&
        isValidMotor(incoming());
      allow delete: if isSignedIn();
    }

    // Categories collection: Public read, Write/Delete for signed-in users
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Admins management: Strictly Super Admins can list, write and delete admin records
    match /admins/{email} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() &&
        isValidEmailId(email) &&
        incoming().email == email &&
        incoming().keys().hasAll(['email', 'addedBy', 'role', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['email', 'addedBy', 'role', 'createdAt', 'updatedAt']) &&
        isValidAdminUser(incoming());

      allow update: if isSuperAdmin() &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        isValidAdminUser(incoming());

      allow delete: if isSuperAdmin() && !isProtectedSuperAdmin(email);
    }
  }
}
